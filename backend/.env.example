# ==============================================
# Personal Wealth Management - Environment Variables
# ==============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================

# -----------------------------------------
# Database Configuration
# -----------------------------------------
# PostgreSQL Connection URL
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/wealth_db

# -----------------------------------------
# Security Configuration
# -----------------------------------------
# JWT Secret Key (generate a secure random key for production)
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production

# JWT Algorithm
ALGORITHM=HS256

# Token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------
# Redis Configuration (for Celery)
# -----------------------------------------
# Redis URL for background task queue
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------
# Optional: External API Keys
# -----------------------------------------
# Alpha Vantage API Key (for market data - optional, yfinance is used by default)
# The app supports either variable name below. Set once in .env.
# ALPHA_VANTAGE_KEY=your_api_key_here
# ALPHA_VANTAGE_API_KEY=your_api_key_here

# Yahoo Finance API key (optional RapidAPI path)
# If omitted, yfinance fallback is still used.
# YAHOO_FINANCE_API_KEY=your_rapidapi_key_here
# YAHOO_FINANCE_API_HOST=apidojo-yahoo-finance-v1.p.rapidapi.com

# -----------------------------------------
# Docker / Deployment
# -----------------------------------------
# PostgreSQL password used by docker-compose (matched in DATABASE_URL above)
# POSTGRES_PASSWORD=changeme
